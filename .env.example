# ------------------------------------------------------------------
# Togather — environment configuration
# Copy this file to `.env` and adjust values before running locally.
# ------------------------------------------------------------------

# SQLite (dev, no external service required). For production,
# switch prisma/schema.prisma `provider` to "postgresql" and use a
# PostgreSQL + PostGIS connection string, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/togather?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign the session cookie (any long random string).
# Generate one with: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth is not wired into this build. When credentials are
# available, add Auth.js with the Google provider and these variables:
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""